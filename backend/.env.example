# Database
DATABASE_URL=

# Security — MUST be set. App will not start without these.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP
OTP_EXPIRE_MINUTES=5

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173

# App
APP_NAME=BizzProfile
APP_ENV=development
DEBUG=true
